# Copy this file to .env and adjust values as needed.
# .env is never committed to source control (see .gitignore).

PORT=3000

# Moyasar TEST/sandbox keys (Step 1 — payment gateway learning project).
# Get these from your own Moyasar dashboard, TEST mode only.
# Never put real/live keys here, and never share the secret key with anyone.
MOYASAR_PUBLISHABLE_KEY_TEST=
MOYASAR_SECRET_KEY_TEST=
